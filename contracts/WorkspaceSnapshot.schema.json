{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escode.dev/contracts/WorkspaceSnapshot.schema.json",
  "title": "WorkspaceSnapshot",
  "description": "EsCode V14 logical contract, proposed schema for implementation review; not yet security-certified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SnapshotId",
    "WorkspaceId",
    "FileHashes",
    "BufferRevisions",
    "CapturedAt",
    "ContractVersion"
  ],
  "properties": {
    "SnapshotId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier; format must be validated at service boundary"
    },
    "WorkspaceId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier; format must be validated at service boundary"
    },
    "GitCommit": {
      "type": "string",
      "minLength": 1
    },
    "WorktreeId": {
      "type": "string",
      "minLength": 1
    },
    "FileHashes": {
      "type": "object"
    },
    "BufferRevisions": {
      "type": "object"
    },
    "CapturedAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "ContractVersion": {
      "type": "integer",
      "const": 1
    }
  }
}