{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escode.dev/contracts/PluginManifest.schema.json",
  "title": "PluginManifest",
  "description": "Metadata-only untrusted plugin schema. Schema-valid input grants no execution permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "PluginId",
    "Publisher",
    "Version",
    "Permissions",
    "TrustLevel",
    "Compatibility",
    "ContractVersion"
  ],
  "properties": {
    "PluginId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "Publisher": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "Version": {
      "type": "string",
      "pattern": "^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}$",
      "maxLength": 17
    },
    "Permissions": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "workspace.read",
          "workspace.search"
        ]
      }
    },
    "TrustLevel": {
      "type": "string",
      "const": "untrusted"
    },
    "Compatibility": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    "Signature": {
      "type": "string",
      "minLength": 1,
      "description": "Current metadata-only validator denies all unverified signatures."
    },
    "ContractVersion": {
      "type": "integer",
      "const": 1
    }
  }
}
