{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://escode.dev/contracts/ToolInvocation.schema.json",
  "title": "ToolInvocation",
  "description": "EsCode V14 logical contract, proposed schema for implementation review; not yet security-certified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "InvocationId",
    "ActorId",
    "ToolId",
    "Resource",
    "ArgsDigest",
    "RiskClass",
    "RequestedAt",
    "ContractVersion"
  ],
  "properties": {
    "InvocationId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier; format must be validated at service boundary"
    },
    "ActorId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier; format must be validated at service boundary"
    },
    "ToolId": {
      "type": "string",
      "minLength": 1
    },
    "Resource": {
      "type": "string",
      "minLength": 1
    },
    "ArgsDigest": {
      "type": "string",
      "minLength": 1
    },
    "RiskClass": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "GrantId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier; format must be validated at service boundary"
    },
    "RequestedAt": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "ContractVersion": {
      "type": "integer",
      "const": 1
    }
  }
}